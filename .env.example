# OpenAI API 설정
OPENAI_API_KEY=your-openai-api-key-here

# PostgreSQL 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kongdak_db
DB_USER=postgres
DB_PASSWORD=your-password-here

# FastAPI 설정
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit 설정
STREAMLIT_PORT=8501

# RAG 설정
FAISS_INDEX_PATH=./data/faiss_index
PDF_DATA_PATH=./Documents/Data

# 영양소 제한 기준 (신장 투석 환자)
SODIUM_LIMIT=650
POTASSIUM_LIMIT=650
PHOSPHORUS_LIMIT=330
PROTEIN_LIMIT=40

# 로깅 설정
LOG_LEVEL=INFO

# Optional: Customize model
OPENAI_MODEL=gpt-4o-mini

# Optional: Vector store path
VECTORSTORE_PATH=./data/vectorstore
