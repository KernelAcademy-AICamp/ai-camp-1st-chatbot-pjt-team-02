# ==================== OpenAI API ====================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
OPENAI_MODEL=gpt-4o-mini

# ==================== MongoDB ====================
# MongoDB Atlas 연결 문자열 (필수)
# 형식: mongodb+srv://username:password@cluster.mongodb.net/database_name
# Atlas Dashboard에서 "Connect" -> "Connect your application"으로 확인 가능
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/chatbot_nutrition?retryWrites=true&w=majority

# 기존 로컬 MongoDB (선택적, 테스트용)
# MONGODB_LOCAL_URI=mongodb://localhost:27017

# ==================== Tavily API (웹 검색) ====================
TAVILY_API_KEY=your_tavily_api_key_here

# ==================== 벡터스토어 ====================
VECTORSTORE_PATH=./data/vectorstore

# ==================== 로깅 ====================
LOG_LEVEL=INFO
